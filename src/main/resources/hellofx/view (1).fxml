<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="0" style="-fx-background-color: #F5EFE6;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hellofx.controllers.ViewController">

    <!-- ===== PAGE CONTENT ===== -->
    <VBox spacing="16" style="-fx-padding: 28 40 28 40;">

        <!-- Back Button + Page Title -->
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Button prefHeight="109.0" prefWidth="74.0" style="-fx-background-color: transparent; -fx-text-fill: #1A4A6B; -fx-font-size: 50px; -fx-cursor: hand; -fx-border-color: transparent;" text="◀" />
            <Label prefHeight="45.0" prefWidth="228.0" style="-fx-text-fill: #1A4A6B; -fx-font-size: 30px; -fx-font-weight: bold;" text="View Lost Items">
            <HBox.margin>
               <Insets left="-35.0" />
            </HBox.margin></Label>
        </HBox>

        <!-- ===== TABLE ===== -->
        <TableView fx:id="approvedTable" prefHeight="400" prefWidth="1000" style="-fx-background-color: #1A4A6B;                           -fx-border-color: #E8A838;                           -fx-border-width: 2;                           -fx-table-cell-border-color: #E8A838;">
            <columns>
                <TableColumn fx:id="itemNameColumn" prefWidth="180" sortable="true" style="-fx-alignment: CENTER;" text="Item Name" />
                <TableColumn fx:id="foundByColumn" prefWidth="160" sortable="true" style="-fx-alignment: CENTER;" text="Found By" />
                <TableColumn fx:id="dateFoundColumn" prefWidth="160" sortable="true" style="-fx-alignment: CENTER;" text="Date Found" />
                <TableColumn fx:id="descriptionColumn" prefWidth="500" sortable="false" style="-fx-alignment: CENTER;" text="Description" />
            </columns>
        </TableView>
    </VBox>
</VBox>
