<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hellofx.controllers.ViewController"
      alignment="TOP_CENTER"
      spacing="20"
      style="-fx-background-color:#0B1E33; -fx-padding:40;">

    <Label text="Approved Items"
           style="-fx-text-fill: gold; -fx-font-size:28px; -fx-font-weight:bold;" />

    <HBox spacing="10" alignment="CENTER">
        <Button text="Sort by Name" onAction="#sortByName" style="-fx-background-color:#1a4d7a; -fx-text-fill:white;" />
        <Button text="Sort by Found By" onAction="#sortByFoundBy" style="-fx-background-color:#1a4d7a; -fx-text-fill:white;" />
        <Button text="Sort by Date" onAction="#sortByDate" style="-fx-background-color:#1a4d7a; -fx-text-fill:white;" />
    </HBox>

    <TableView fx:id="approvedTable" prefWidth="700" prefHeight="420" maxWidth="700" maxHeight="420">
        <columns>
            <TableColumn fx:id="itemNameColumn" text="Item Name" prefWidth="150" sortable="true"/>
            <TableColumn fx:id="foundByColumn" text="Found By" prefWidth="150" sortable="true"/>
            <TableColumn fx:id="dateFoundColumn" text="Date Found" prefWidth="150" sortable="true"/>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="250" sortable="false"/>
        </columns>
    </TableView>
</VBox>