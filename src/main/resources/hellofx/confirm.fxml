<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600" prefWidth="1000" style="-fx-background-color:#FAF0E6;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

        <!-- MAIN CONTENT -->
        <center>
                <VBox spacing="15" style="-fx-padding:30;">

                        <!-- Back title -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label style="-fx-text-fill:#1B3A5C; -fx-font-size:20px; -fx-font-weight:bold;" text="◀" />
                                <Label style="-fx-text-fill: #1B3A5C; -fx-font-size: 40px; -fx-font-weight: bold;" text="Report Lost Item" />
                        </HBox>

                        <!-- Confirmation Box -->
                        <VBox alignment="CENTER" prefHeight="300" spacing="15" style="-fx-background-color: #013D5A; -fx-background-radius: 8; -fx-padding: 60;">
                                <Label style="-fx-text-fill: white; -fx-font-size: 40px; -fx-font-weight: bold;" text="The Item has been reported." />
                                <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-style: italic;" text="Thank you" />
            <VBox.margin>
               <Insets top="50.0" />
            </VBox.margin>
                        </VBox>

                </VBox>
        </center>

</BorderPane>
