<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600" prefWidth="1000" style="-fx-background-color:#FAF0E6;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hellofx.controllers.ReportController">

        <center>
                <VBox fx:id="formArea" spacing="20" style="-fx-padding:30;">

                        <HBox alignment="CENTER_LEFT" spacing="10">
                                <Button text="◀" onAction="#goHome" style="-fx-background-color: transparent; -fx-text-fill: #1B3A5C; -fx-font-size: 20px; -fx-font-weight:bold; -fx-cursor: hand;" />
                                <Label style="-fx-text-fill:#1B3A5C; -fx-font-size:26px; -fx-font-weight:bold;" text="Report Lost Item" />
                        </HBox>

                        <Label style="-fx-text-fill:#E8A020; -fx-font-size:13px; -fx-font-style:italic;" text="Please fill out the following:" />

                        <HBox alignment="CENTER" spacing="15">
                                <VBox prefHeight="280" prefWidth="210" spacing="10" style="-fx-background-color:#1B5C7A; -fx-padding:15; -fx-background-radius:6;">
                                        <Label style="-fx-text-fill:white; -fx-font-size:14px; -fx-font-weight:bold;" text="Item Name:" />
                                        <TextField fx:id="itemName" promptText="Enter item name" style="-fx-background-color:white;" />
                                </VBox>
                                <VBox prefHeight="280" prefWidth="210" spacing="10" style="-fx-background-color:#1B5C7A; -fx-padding:15; -fx-background-radius:6;">
                                        <Label style="-fx-text-fill:white; -fx-font-size:14px; -fx-font-weight:bold;" text="Found By:" />
                                        <TextField fx:id="foundBy" promptText="Enter finder name" style="-fx-background-color:white;" />
                                </VBox>
                                <VBox prefHeight="280" prefWidth="210" spacing="10" style="-fx-background-color:#1B5C7A; -fx-padding:15; -fx-background-radius:6;">
                                        <Label style="-fx-text-fill:white; -fx-font-size:14px; -fx-font-weight:bold;" text="Date Found:" />
                                        <TextField fx:id="date" promptText="Enter date found" style="-fx-background-color:white;" />
                                </VBox>
                                <VBox prefHeight="280" prefWidth="210" spacing="10" style="-fx-background-color:#1B5C7A; -fx-padding:15; -fx-background-radius:6;">
                                        <Label style="-fx-text-fill:white; -fx-font-size:14px; -fx-font-weight:bold;" text="Description:" />
                                        <TextArea fx:id="description" prefHeight="200" promptText="Enter description" style="-fx-background-color:white;" wrapText="true" />
                                </VBox>
                        </HBox>

                        <HBox alignment="CENTER">
                                <Button onAction="#submitItem" prefHeight="40" prefWidth="140" style="-fx-background-color:#1B3A5C; -fx-text-fill:white; -fx-font-size:13px; -fx-cursor:hand;" text="Submit" />
                        </HBox>

                </VBox>
        </center>

</BorderPane>
